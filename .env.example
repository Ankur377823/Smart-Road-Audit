# ==========================================
# SmartRoad-Audit Docker Environment Config
# ==========================================

# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smartroad_audit
POSTGRES_PORT=5432

# Backend Settings
BACKEND_PORT=8000
APP_NAME="SmartRoad Audit API"
DEMO_MODE=true
GOOGLE_MAPS_API_KEY=

# CORS configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://127.0.0.1:80,http://localhost,http://127.0.0.1

# Frontend Settings
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
